{
    "name": "@poweragents/app",
    "private": true,
    "description": "The poweragents app (Nuxt SPA, built to static files and shown by the desktop shell)",
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        "./*.js": "./*.ts",
        "./*.vue": "./*.vue"
    },
    "scripts": {
        "dev": "nuxt dev --bun",
        "build": "nuxt generate --bun",
        "prep": "nuxt prepare",
        "typecheck": "nuxi typecheck"
    },
    "dependencies": {
        "@lucide/vue": "1.72.0",
        "@nzyme/fetch-utils": "workspace:*",
        "@nzyme/i18n": "workspace:*",
        "@nzyme/i18n-core": "workspace:*",
        "@nzyme/ioc": "workspace:*",
        "@nzyme/logging": "workspace:*",
        "@nzyme/rpc": "workspace:*",
        "@nzyme/utils": "workspace:*",
        "@nzyme/vue": "workspace:*",
        "@nzyme/vue-forms": "workspace:*",
        "@nzyme/vue-i18n": "workspace:*",
        "@nzyme/vue-ioc": "workspace:*",
        "@nzyme/vue-utils": "workspace:*",
        "@poweragents/common": "workspace:*",
        "@poweragents/ui": "workspace:*",
        "@tauri-apps/api": "2.12.4",
        "@tauri-apps/plugin-opener": "2.7.3",
        "nuxt": "4.4.8",
        "reka-ui": "2.10.5",
        "vue": "3.5.45",
        "vue-router": "^5.4.0"
    },
    "devDependencies": {
        "@nzyme/nuxt-tools": "workspace:*",
        "@nzyme/project-utils": "workspace:*",
        "sass": "1.108.1",
        "typescript": "6.0.3",
        "vite": "7.3.7",
        "vue-tsc": "^3.3.13"
    },
    "nx": {
        "namedInputs": {
            "appEnvironment": [
                {
                    "runtime": "cat packages/app/.env packages/app/.env.${ENV:-dev} 2>/dev/null | git hash-object --stdin"
                }
            ]
        },
        "targets": {
            "build": {
                "dependsOn": [
                    "^build",
                    "typecheck"
                ]
            }
        }
    }
}
