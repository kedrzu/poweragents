{
    "extends": "@nzyme/tsconfig/esm.json",
    "compilerOptions": {
        "noEmit": true,
        "composite": false,
        "incremental": false,
        // Playwright runs specs in Node; `dom` types the code they evaluate in the page.
        "lib": ["esnext", "dom", "dom.iterable"],
        "types": ["node", "bun"]
    },
    "include": ["src", "playwright.config.ts"]
}
