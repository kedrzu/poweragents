{
    "name": "@poweragents/daemon",
    "version": "0.0.0",
    "private": true,
    "description": "The background service: owns the sandbox, the agent engine, schedules, the browser and plugins, and serves the clients over a local port",
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        "./*.js": {
            "types": "./dist/*.d.ts",
            "source": "./src/*.ts",
            "import": "./dist/*.js",
            "default": "./dist/*.js"
        }
    },
    "scripts": {
        "dev": "bun --watch ./src/main.ts",
        "start": "bun ./dist/main.js",
        "sidecar": "tsgo --build && bun ../../scripts/bundleDaemonSidecar.ts"
    },
    "dependencies": {
        "@poweragents/common": "workspace:*"
    },
    "devDependencies": {
        "@nzyme/tsconfig": "workspace:*"
    },
    "nx": {
        "targets": {
            "sidecar": {
                "cache": false
            }
        }
    }
}
